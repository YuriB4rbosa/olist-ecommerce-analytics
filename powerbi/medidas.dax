// =====================================================================================
// Medidas DAX do dashboard Olist  —  copie cada bloco em "Nova medida" (ou "Nova coluna")
// Modelo: ver docs/powerbi_modelo.md · Valores esperados: docs/powerbi_dashboard.md
//
// REGRAS DO MODELO QUE ESTAS MEDIDAS RESPEITAM
//  1) Receita vive em fato_itens. O filtro de pedido/data/UF desce de fato_pedidos para fato_itens.
//  2) O filtro NÃO sobe de fato_itens para fato_pedidos. Por isso medidas de pedido (atraso, nota)
//     que precisam reagir a categoria/vendedor usam DISTINCTCOUNT(fato_itens[id_pedido]) ou CROSSFILTER.
//  3) Em DAX, BLANK() = 0 é VERDADEIRO. Por isso as flags são testadas sempre com "= 1" e nunca com "= 0"
//     (use fato_pedidos[entregue] = 1 para o universo de pedidos entregues).
//  4) Filtro de relatório recomendado: dim_data[periodo_analise] = 1 (jan/2017–ago/2018).
// =====================================================================================


// ---------- 1. RECEITA E PEDIDOS ---------------------------------------------------

Faturamento =
CALCULATE (
    SUM ( fato_itens[receita] ),
    fato_pedidos[pedido_valido] = 1
)

Frete Total =
CALCULATE (
    SUM ( fato_itens[valor_frete] ),
    fato_pedidos[pedido_valido] = 1
)

Pedidos =
CALCULATE (
    DISTINCTCOUNT ( fato_itens[id_pedido] ),
    fato_pedidos[pedido_valido] = 1
)

Ticket Médio =
DIVIDE ( [Faturamento], [Pedidos] )

Frete % do Faturamento =
DIVIDE ( [Frete Total], [Faturamento] )

% do Faturamento Total =
DIVIDE ( [Faturamento], CALCULATE ( [Faturamento], ALLSELECTED () ) )


// ---------- 2. COMPARAÇÃO NO TEMPO (exige dim_data marcada como tabela de datas) -----

Faturamento Mês Anterior =
CALCULATE ( [Faturamento], DATEADD ( dim_data[data], -1, MONTH ) )

Var MoM % =
DIVIDE ( [Faturamento] - [Faturamento Mês Anterior], [Faturamento Mês Anterior] )

Faturamento Ano Anterior =
CALCULATE ( [Faturamento], SAMEPERIODLASTYEAR ( dim_data[data] ) )

Var YoY % =
DIVIDE ( [Faturamento] - [Faturamento Ano Anterior], [Faturamento Ano Anterior] )


// ---------- 3. LOGÍSTICA (base = pedidos distintos; reage a data, UF, categoria e vendedor) ----

Pedidos Entregues =
CALCULATE (
    DISTINCTCOUNT ( fato_itens[id_pedido] ),
    fato_pedidos[entregue] = 1
)

Pedidos Atrasados =
CALCULATE (
    DISTINCTCOUNT ( fato_itens[id_pedido] ),
    fato_pedidos[atrasado] = 1
)

% Pedidos Atrasados =
DIVIDE ( [Pedidos Atrasados], [Pedidos Entregues] )

Prazo Mediano de Entrega (dias) =
CALCULATE (
    MEDIAN ( fato_pedidos[dias_entrega] ),
    CROSSFILTER ( fato_itens[id_pedido], fato_pedidos[id_pedido], BOTH )
)

Atraso Médio dos Atrasados (dias) =
CALCULATE (
    AVERAGE ( fato_pedidos[dias_atraso] ),
    fato_pedidos[atrasado] = 1,
    CROSSFILTER ( fato_itens[id_pedido], fato_pedidos[id_pedido], BOTH )
)


// ---------- 4. SATISFAÇÃO ---------------------------------------------------------

Nota Média =
CALCULATE (
    AVERAGE ( fato_pedidos[nota_avaliacao] ),
    CROSSFILTER ( fato_itens[id_pedido], fato_pedidos[id_pedido], BOTH )
)

% Avaliações 1-2 =
VAR _avaliadas =
    CALCULATE (
        COUNT ( fato_pedidos[nota_avaliacao] ),
        CROSSFILTER ( fato_itens[id_pedido], fato_pedidos[id_pedido], BOTH )
    )
VAR _ruins =
    CALCULATE (
        COUNT ( fato_pedidos[nota_avaliacao] ),
        fato_pedidos[nota_avaliacao] <= 2,
        CROSSFILTER ( fato_itens[id_pedido], fato_pedidos[id_pedido], BOTH )
    )
RETURN
    DIVIDE ( _ruins, _avaliadas )


// ---------- 5. CLIENTES E RECOMPRA (pessoa = id_cliente_unico) --------------------

Clientes =
CALCULATE (
    DISTINCTCOUNT ( fato_pedidos[id_cliente_unico] ),
    fato_pedidos[pedido_valido] = 1
)

Clientes Recorrentes =
CALCULATE (
    DISTINCTCOUNT ( fato_pedidos[id_cliente_unico] ),
    fato_pedidos[pedido_valido] = 1,
    fato_pedidos[cliente_recorrente] = 1
)

Taxa de Recompra =
DIVIDE ( [Clientes Recorrentes], [Clientes] )

Clientes Novos =
CALCULATE (
    DISTINCTCOUNT ( fato_pedidos[id_cliente_unico] ),
    fato_pedidos[pedido_valido] = 1,
    fato_pedidos[primeira_compra] = 1
)

// Cohort: % dos clientes de cada mês de 1ª compra que voltam a comprar k meses depois.
// Matriz: linhas = fato_pedidos[mes_coorte], colunas = fato_pedidos[Meses Desde 1ª Compra].
Retenção Cohort =
VAR _tamanho_cohort =
    CALCULATE (
        [Clientes],
        REMOVEFILTERS ( fato_pedidos[Meses Desde 1ª Compra] ),
        fato_pedidos[Meses Desde 1ª Compra] = 0
    )
RETURN
    DIVIDE ( [Clientes], _tamanho_cohort )


// ---------- 6. COLUNAS CALCULADAS (tabela fato_pedidos) -------------------------------
// Criar em: fato_pedidos > Nova coluna

Meses Desde 1ª Compra =
IF (
    ISBLANK ( fato_pedidos[mes_coorte] ),
    BLANK (),
    DATEDIFF ( fato_pedidos[mes_coorte], fato_pedidos[datahora_compra], MONTH )
)

Faixa Atraso =
VAR _d = fato_pedidos[dias_atraso]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( _d ), BLANK (),
        _d < 0, "1. Adiantado",
        _d = 0, "2. No dia",
        _d <= 3, "3. 1–3 dias",
        _d <= 7, "4. 4–7 dias",
        _d <= 14, "5. 8–14 dias",
        "6. > 14 dias"
    )

Faixa Parcelas =
VAR _p = fato_pedidos[parcelas_max]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( _p ), BLANK (),
        _p <= 1, "1. 1x",
        _p <= 3, "2. 2–3x",
        _p <= 6, "3. 4–6x",
        _p <= 10, "4. 7–10x",
        "5. > 10x"
    )

Valor Produtos =
SUMX ( RELATEDTABLE ( fato_itens ), fato_itens[receita] )

Faixa Valor Pedido =
VAR _v = fato_pedidos[Valor Produtos]
RETURN
    SWITCH (
        TRUE (),
        _v = 0, BLANK (),        // pedido sem item (BLANK() = 0 em DAX)
        _v <= 50, "1. Até R$ 50",
        _v <= 100, "2. R$ 50–100",
        _v <= 200, "3. R$ 100–200",
        _v <= 500, "4. R$ 200–500",
        "5. > R$ 500"
    )
